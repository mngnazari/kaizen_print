# ===============================
# 🔧 Environment Variables Example
# ===============================
# این فایل نمونه‌ای از متغیرهای محیطی است
# یک کپی از این فایل با نام .env بسازید و مقادیر واقعی را وارد کنید

# 🤖 Bot Token (از BotFather دریافت کنید)
BOT_TOKEN=7943645778:AAEXYzDKUc2D7mWaTcLrSkH4AjlJvVq7PaU

# 👤 Admin ID (آیدی عددی تلگرام ادمین)
ADMIN_ID=2138687434

# 👥 Operators IDs (آیدی‌های اپراتورها - با کاما جدا کنید)
# مثال: OPERATORS_IDS=123456789,987654321
OPERATORS_IDS=

# ✏️ Editors IDs (آیدی‌های ادیتورها - با کاما جدا کنید)
# مثال: EDITORS_IDS=111222333,444555666
EDITORS_IDS=

# 👁️ Visitors IDs (آیدی‌های ویزیتورها - با کاما جدا کنید)
# مثال: VISITORS_IDS=777888999,123123123
VISITORS_IDS=

# 🗄️ Database URL (پیشفرض: SQLite)
DATABASE_URL=sqlite:///./kaizen_bot.db

# 📝 Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 🐛 Debug Mode (True/False)
DEBUG=False
