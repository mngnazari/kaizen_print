# ===============================
# ⚙️ تنظیمات اصلی ربات
# ===============================
#
# دستورالعمل:
# 1. این فایل را کپی کرده و به نام config.py ذخیره کنید
# 2. مقادیر را با اطلاعات واقعی خود پر کنید
# 3. config.py در .gitignore قرار دارد و کامیت نمی‌شود

# 🔐 توکن ربات تلگرام
# از BotFather دریافت کنید: https://t.me/BotFather
TOKEN = "YOUR_BOT_TOKEN_HERE"

# 👤 شناسه ادمین اصلی
# برای دریافت ID خود، به ربات @userinfobot پیام دهید
ADMIN_ID = 0  # جایگزین کنید با شناسه خود

# 👥 شناسه‌های اپراتورها
OPERATORS_IDS = [
    # در اینجا ID اپراتورها را اضافه کنید
    # مثال: 123456789,
]

# ✏️ شناسه‌های ادیتورها
EDITORS_IDS = [
    # در اینجا ID ادیتورها را اضافه کنید
    # مثال: 987654321,
]

# 👁️ شناسه‌های بازدیدکنندگان
VISITORS_IDS = [
    # در اینجا ID بازدیدکنندگان را اضافه کنید
    # مثال: 456789123,
]
